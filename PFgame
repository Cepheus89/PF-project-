    projSprite.setOrigin({projBounds.size.x / 2.f, projBounds.size.y / 2.f});

    // Hazard trail dot shape
    sf::CircleShape hazardDot(3.0f);
    hazardDot.setFillColor(sf::Color(255, 69, 0, 200));
    hazardDot.setOrigin({3.0f, 3.0f});

    //used to change current state of game from menu too playing ;
    //change this and add an endless mode also make it go back to menu if escape pressed during the playing stage
    bool changeState = false;

    while (window.isOpen()) {
        float dt = frameClock.restart().asSeconds();

        //this statemet check that if there new games is pressed we change menu too the recent menu and end the previous menu
        if (!changeState){

            //required functions for menu
            starfieldBackground(myStars, starBackground);
            menu_Interaction(window, view, currentState, hoveredIndex,
                 mainMenuItems, startMenuItems, startOptions,
                 difficultyIndex, difficulties, font, changeState, speed, projectileSpeed, waveInterval, launchInterval);

            rendering(window, starBackground, currentState, titletext,
                    mainMenuItems, startMenuItems, font, difficulties[difficultyIndex]);

        }
        else {
            while (const std::optional<sf::Event> event = window.pollEvent()) {
                if (event->is<sf::Event::Closed>()) {
                    window.close();
                }
                else if (const auto* keyPressed = event->getIf<sf::Event::KeyPressed>()) {
                    if (keyPressed->scancode == sf::Keyboard::Scancode::Escape) {
                            currentState = GameState::Menu; // (removed the "GameState" type so this changes the real variable instead of making a new local one)
                            hoveredIndex = -1;
                            changeState = false ; //a pause menu can be created :
                    }
                }
            }

            // Call player movement with box collision constraint yay I love when they suffer
            handlePlayerMovement(Playersprite, speed, battleBox);

            bool nextwave = false;
            if (wavecount <= 3) {
                nextwave = allLaunched(activeProjectiles);
            }
            else {
                nextwave = activeProjectiles.empty();
            }

            if (waveTriggerClock.getElapsedTime().asSeconds() >= waveInterval && nextwave) {
                waveTriggerClock.restart();
                float spawnposition = 220.0f;

                float leftX = width * 0.25f;
                float middleX = width * 0.5f;
                float rightX = width * 0.75f;

                if (wavecount == 0) {
                    crescent(activeProjectiles, middleX, spawnposition, 0.15f, launchInterval);
                }
                else if (wavecount == 1) {
                    crescent(activeProjectiles, rightX, spawnposition, 0.15f, launchInterval);
                }
                else if (wavecount == 2) {
                    crescent(activeProjectiles, leftX, spawnposition, 0.15f, launchInterval);
                }
                else if (wavecount == 3) {
                    crescent(activeProjectiles, leftX, spawnposition, 0.15f, launchInterval);
                    crescent(activeProjectiles, middleX, spawnposition, 0.15f, launchInterval);
                    crescent(activeProjectiles, rightX, spawnposition, 0.15f, launchInterval);
                }
                else if (wavecount == 4) {
                    horizontal(activeProjectiles, battleBox, projectileSpeed, -45.0f);
                    horizontal(activeProjectiles, battleBox, projectileSpeed, 0.0f);
                }
                else if (wavecount == 5) {
                    horizontal(activeProjectiles, battleBox, projectileSpeed, 0.0f);
                    horizontal(activeProjectiles, battleBox, projectileSpeed, 30.0f);
                }
                else if (wavecount == 6) {
                    pinwheel(activeProjectiles, {middleX, battleBox.getPosition().y}, projectileSpeed);
                }
                else if (wavecount == 7) {
                    pinwheel(activeProjectiles, {rightX, battleBox.getPosition().y}, projectileSpeed);
                }
                else if (wavecount == 8) {
                    pinwheel(activeProjectiles, {leftX, battleBox.getPosition().y}, projectileSpeed);
                }
                else if (wavecount == 9) {
                    homingdarts(activeProjectiles, battleBox, middleX);
                }
                else if (wavecount == 10) {
                    homingdarts(activeProjectiles, battleBox, rightX);
                }
                else if (wavecount == 11) {
                    homingdarts(activeProjectiles, battleBox, leftX);
                }

                wavecount = (wavecount + 1) % 12; //loops the game for now
            }
            //checks for the projectile updates
            updateProjectiles(activeProjectiles, dt, width, height, Playersprite.getPosition(), projectileSpeed);

            // checks collisions
            if (collision(activeProjectiles, Playersprite.getPosition())) {
                Playersprite.setPosition(battleBox.getPosition()); // Reset to center on hit for now
            }

            // Dialogue box positioning
            sf::Vector2f bossPos = Bosssprite.getPosition();
            sf::Vector2f bubbleOffset(65.0f, -35.0f);
            speechBubble.setPosition(bossPos + bubbleOffset);
            speech.setPosition(speechBubble.getPosition() + sf::Vector2f(10.0f, 8.0f));
            window.clear();
             // Draw static UI and Box first cuz
            window.draw(battleBox);
            window.draw(Bosssprite);
            window.draw(speechBubble);
            window.draw(speech);
            // draw the projectiles with the hazard trail
            for (const auto& proj : activeProjectiles) {
                for (const auto& hazard : proj.trail) {
                    hazardDot.setPosition(hazard.position);
                    window.draw(hazardDot);
                }

                if (proj.spawnDelay <= 0.0f && (proj.isLaunched || proj.launchTimer > 0.0f)) {
                    projSprite.setPosition(proj.position);
                    window.draw(projSprite);
                }
            }
            // Draw Player on top
            window.draw(Playersprite);
            window.display();
            }
    }
    return 0;
}
