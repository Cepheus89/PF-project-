// Player movement function with box containment
void handlePlayerMovement(sf::Sprite& playerSprite, float speed, const sf::RectangleShape& battleBox) { //we need the sprite, the speed and the rectangle box to trap the player to prevent excess movement
    sf::Vector2f pos = playerSprite.getPosition(); //ooh so apparently as we go down, distance increase? oh well
    //the movement stuff is self explanatory except one thing which I wrote down
    if (sf::Keyboard::isKeyPressed(sf::Keyboard::Scan::S)) {
        pos.y+=speed; //so over here, the tutorial told me that y actually increases as we go down. Be careful of this omg I hate SFML
    }
    if (sf::Keyboard::isKeyPressed(sf::Keyboard::Scan::W)) {
        pos.y-=speed;
    }
    if (sf::Keyboard::isKeyPressed(sf::Keyboard::Scan::D)) {
        pos.x+=speed;
    }
    if (sf::Keyboard::isKeyPressed(sf::Keyboard::Scan::A)) {
        pos.x-=speed;
    }

    // exact explanation at the bottom
    sf::Vector2f boxPosition = battleBox.getPosition(); //obtaining the exact coordinates of the box centre
    sf::Vector2f boxSize = battleBox.getSize(); //getting the width and height of the box because I tried to define the height and width
                                                //directly into the code itself and I realized that I might need to change it later so I used getSize. Cool thing
    float left = boxPosition.x - (boxSize.x / 2.0f) + 8.0f;
    float right = boxPosition.x + (boxSize.x / 2.0f) - 8.0f;
    float top = boxPosition.y - (boxSize.y / 2.0f) + 8.0f;
    float bottom = boxPosition.y + (boxSize.y / 2.0f) - 8.0f;

    if (pos.x < left) {
        pos.x = left;
    }
    if (pos.x > right) {
        pos.x = right;
    }
    if (pos.y < top) {
        pos.y = top;
    }
    if (pos.y > bottom) {
        pos.y = bottom;
    }
